<% messages.forEach(message => { %>

    <article>

        <h3><%= message.title %></h3>

        <p><%= message.message %></p>

        <% if (message.username) { %>
            <p>Author: <%= message.username %></p>
            <p>Date: <%= message.created_at %></p>
        <% } %>

        <% if (user && user.is_admin) { %>
            <form
                action="/messages/delete/<%= message.id %>"
                method="POST"
            >

                <input
                    type="hidden"
                    name="_csrf"
                    value="<%= csrfToken %>"
                >
                <button type="submit">
                    Delete
                </button>
            </form>
        <% } %>

    </article>

<% }) %>