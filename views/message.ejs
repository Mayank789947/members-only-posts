<!DOCTYPE html>

<html lang="en">

<%- include("partials/head") %>

<body>

<%- include("partials/header") %>

<%- include("partials/nav") %>

    <main class="message-page">

        <article class="message-detail">

            <h1 class="message-detail-title">
                <%= message.title %>
            </h1>

            <p class="message-content">
                <%= message.message %>
            </p>

            <% if (access === "guest") { %>

                <div class="message-access guest-access">

                    <p>
                        To see the full details, please log in to your account.
                    </p>

                    <a
                        class="message-action-link"
                        href="/login"
                    >
                        Login
                    </a>

                </div>

            <% } else if (access === "non-member") { %>

                <div class="message-access member-access">

                    <p>
                        Author: Hidden
                    </p>

                    <p>
                        Posted: Hidden
                    </p>

                    <p>
                        Become a member to see the author and posting time.
                    </p>

                    <form
                        action="/users/join-club"
                        method="POST"
                    >

                        <button
                            class="message-action-button"
                            type="submit"
                        >
                            Join Club
                        </button>

                    </form>

                </div>

            <% } else { %>

                <div class="message-meta">

                    <p>
                        <strong>Author:</strong>
                        <%= message.username %>
                    </p>

                    <p>
                        <strong>Posted:</strong>
                        <%= message.created_at.toLocaleString() %>
                    </p>

                    <% if (message.updated_at) { %>

                        <p>
                            <strong>Updated:</strong>
                            <%= message.updated_at.toLocaleString() %>
                        </p>

                    <% } %>

                </div>


                <% if (access === "admin" || access === "owner") { %>

                    <div class="message-actions">

                        <a
                            class="message-action-link"
                            href="/messages/<%= message.id %>/edit"
                        >
                            Edit Message
                        </a>

                        <% if (access === "admin") { %>

                            <form
                                class="delete-message-form"
                                action="/messages/delete/<%= message.id %>"
                                method="POST"
                            >

                                <button
                                    class="delete-message-button"
                                    type="submit"
                                >
                                    Delete Message
                                </button>

                            </form>

                        <% } %>

                    </div>

                <% } %>

            <% } %>

            <a
                class="back-home-link"
                href="/"
            >
                Back to Home
            </a>

        </article>

    </main>

<%- include("partials/footer") %>

</body>

</html>