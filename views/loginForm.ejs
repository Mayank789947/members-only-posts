<!DOCTYPE html>

<html lang="en">

<%- include("partials/head") %>

<body>

    <%- include("partials/header") %>

    <%- include("partials/nav") %>

    <main class="form-page">

        <section class="form-container">

            <h1 class="form-title">
                Login
            </h1>

            <form
                class="auth-form"
                action="/login"
                method="POST"
            >
            <% if (errors?.auth) { %>

                <p class="form-auth-error">
                <%= errors.auth.msg %>
                </p>

            <% } %>

                <input
                    type="hidden"
                    name="_csrf"
                    value="<%= csrfToken %>"
                >

                <div class="form-group">

                    <label for="email">
                        Email
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        value="<%= values?.email || '' %>"
                        required
                    >

                    <% if (errors?.email) { %>

                        <p class="field-error">
                            <%= errors.email.msg %>
                        </p>

                    <% } %>

                </div>

                <div class="form-group">

                    <label for="password">
                        Password
                    </label>

                    <input
                        type="password"
                        id="password"
                        name="password"
                        required
                    >

                    <% if (errors?.password) { %>

                        <p class="field-error">
                            <%= errors.password.msg %>
                        </p>

                    <% } %>

                </div>

                <% if (returnTo) { %>

                    <input
                        type="hidden"
                        name="returnTo"
                        value="<%= returnTo %>"
                    >

                <% } %>

                <button
                    class="form-submit"
                    type="submit"
                >
                    Login
                </button>

            </form>

            <div class="form-footer">

                <p>
                    New to Members Only?
                </p>

                <a href="/users/create">
                    Create an account
                </a>

            </div>

        </section>

    </main>

    <%- include("partials/footer") %>

</body>

</html>