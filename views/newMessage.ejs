<!DOCTYPE html>

<html lang="en">

<%- include("partials/head") %>

<body>

    <%- include("partials/header") %>

    <%- include("partials/nav") %>

    <main class="form-page">

        <section class="form-container">

            <h1 class="form-title">
                Create New Message
            </h1>

            <form
                class="auth-form"
                action="/messages/create"
                method="POST"
            >
                <input
                       type="hidden"
                       name="_csrf"
                       value="<%= csrfToken %>"
                >

                <div class="form-group">

                    <label for="title">
                        Title
                    </label>

                    <input
                        type="text"
                        id="title"
                        name="title"
                        value="<%= values.title || '' %>"
                        required
                    >

                    <% if (errors?.title) { %>

                        <p class="field-error">
                            <%= errors.title.msg %>
                        </p>

                    <% } %>

                </div>

                <div class="form-group">

                    <label for="message">
                        Message
                    </label>

                    <textarea
                        id="message"
                        name="message"
                        rows="6"
                        required
                    ><%= values.message || '' %></textarea>

                    <% if (errors?.message) { %>

                        <p class="field-error">
                            <%= errors.message.msg %>
                        </p>

                    <% } %>

                </div>

                <button
                    class="form-submit"
                    type="submit"
                >
                    Post Message
                </button>

            </form>

        </section>

    </main>

    <%- include("partials/footer") %>

</body>

</html>