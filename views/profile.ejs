<!DOCTYPE html>

<html lang="en">

<%- include("partials/head") %>

<body>

    <%- include("partials/header") %>

    <%- include("partials/nav") %>

    <main class="profile-page">

        <section class="profile-container">

            <h1 class="profile-title">
                Profile
            </h1>

            <div class="profile-info">

                <div class="profile-field">

                    <span class="profile-label">
                        Username
                    </span>

                    <span class="profile-value">
                        <%= user.username %>
                    </span>

                </div>

                <div class="profile-field">

                    <span class="profile-label">
                        First Name
                    </span>

                    <span class="profile-value">
                        <%= user.first_name %>
                    </span>

                </div>

                <div class="profile-field">

                    <span class="profile-label">
                        Last Name
                    </span>

                    <span class="profile-value">
                        <%= user.last_name %>
                    </span>

                </div>

                <div class="profile-field">

                    <span class="profile-label">
                        Email
                    </span>

                    <span class="profile-value">
                        <%= user.email %>
                    </span>

                </div>

                <div class="profile-field">

                    <span class="profile-label">
                        Membership
                    </span>

                    <span class="profile-value">
                        <% if (user.membership_status) { %>
                            Member
                        <% } else { %>
                            Non-member
                        <% } %>
                    </span>

                </div>

                <% if (user.is_admin) { %>

                    <div class="profile-field">

                        <span class="profile-label">
                            Role
                        </span>

                        <span class="profile-value">
                            Admin
                        </span>

                    </div>

                <% } %>

            </div>

            <div class="profile-actions">

                <% if (user.is_admin) { %>

                    <p class="admin-message">
                        You have administrator access.
                    </p>

                <% } else if (user.membership_status) { %>

                    <form
                        action="/users/leave-club"
                        method="POST"
                    >

                    <input
                           type="hidden"
                           name="_csrf"
                           value="<%= csrfToken %>"
                    >

                        <button
                            class="profile-button"
                            type="submit"
                        >
                            Leave Club
                        </button>
                    </form>

                <% } else { %>

                    <form
                        action="/users/join-club"
                        method="POST"
                    >

                        <input
                           type="hidden"
                           name="_csrf"
                           value="<%= csrfToken %>"
                        >
                        <button
                            class="profile-button"
                            type="submit"
                        >
                            Join Club
                        </button>
                    </form>

                <% } %>

            </div>

        </section>

    </main>

    <%- include("partials/footer") %>

</body>

</html>