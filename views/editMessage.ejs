<!DOCTYPE html>
<html lang="en">

<%- include("partials/head") %>

<body>

    <%- include("partials/header") %>

    <%- include("partials/nav") %>

    <main>

        <section class="form-page">

            <div class="form-container">

                <h1 class="form-title">
                    Edit Message
                </h1>

                <% if (errors && Object.keys(errors).length > 0) { %>

                    <ul class="form-errors">

                        <% Object.values(errors).forEach(error => { %>

                            <li class="field-error">
                                <%= error.msg %>
                            </li>

                        <% }) %>

                    </ul>

                <% } %>

                <form
                    class="auth-form"
                    action="/messages/<%= message.id %>/edit"
                    method="POST"
                >
                    <input
                        type="hidden"
                        name="_csrf"
                        value="<%= csrfToken %>"
                    >

                    <div class="form-group">

                        

                        <label for="title">
                            Title
                        </label>

                        <input
                            type="text"
                            id="title"
                            name="title"
                            value="<%= values.title %>"
                            required
                        >

                    </div>

                    <div class="form-group">

                        <label for="message">
                            Message
                        </label>

                        <textarea
                            id="message"
                            name="message"
                            required
                        ><%= values.message %></textarea>

                    </div>

                    <button
                        class="form-submit"
                        type="submit"
                    >
                        Save Changes
                    </button>

                </form>

            </div>

        </section>

    </main>

    <%- include("partials/footer") %>

</body>

</html>